---
import { getCollection } from 'astro:content';
import ArrowRight from '../assets/icons/arrow-right.svg';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import PostPreview from '../components/PostPreview.astro';
import CasePreview from '../components/CasePreview.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import Subscribe from '../components/Subscribe.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortItemsByDateDesc, isPublished } from '../utils/data-utils';

const posts = (await getCollection('blog', isPublished)).sort(sortItemsByDateDesc);
const featuredPosts = posts.filter(({ data }) => data.isFeatured);

const projects = (await getCollection('projects', isPublished)).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const featuredProjects = projects.filter(({ data }) => data.isFeatured);

const cases = (await getCollection('cases', isPublished)).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const featuredCases = cases.filter(({ data }) => data.isFeatured);

const services = siteConfig.services ?? [];
const clients = siteConfig.clients ?? [];
const columns = siteConfig.columns ?? [];
---

<BaseLayout description={siteConfig.description}>
    <Hero {...siteConfig.hero} />

    {clients.length > 0 && (
        <section class="border-main mb-16 border-y border-dashed py-6 sm:mb-24" aria-labelledby="clientes">
            <h2 id="clientes" class="mb-2 text-sm">Já trabalhou com</h2>
            <p class="font-serif text-xl leading-snug sm:text-2xl">{clients.join(' · ')}</p>
            <a class="mt-3 inline-block text-sm underline decoration-dashed underline-offset-2 hover:decoration-solid" href="/clientes">
                Ver todos os clientes
            </a>
        </section>
    )}

    {services.length > 0 && (
        <section class="mb-16 sm:mb-24" aria-labelledby="como-trabalho">
            <h2 id="como-trabalho" class="mb-12 font-serif text-xl italic sm:mb-16 sm:text-2xl">Como eu trabalho</h2>
            {services.map((service) => (
                <a class="group mb-10 flex items-start justify-between gap-8 sm:mb-12" href={service.href}>
                    <div class="grow">
                        <h3 class="font-serif text-xl leading-tight font-medium group-hover:underline group-hover:decoration-dashed group-hover:decoration-1 group-hover:underline-offset-4 sm:text-2xl">
                            {service.title}
                        </h3>
                        <p class="mt-2 text-sm leading-normal sm:text-base">{service.text}</p>
                    </div>
                    <div class="hidden font-serif italic opacity-0 transition group-hover:opacity-100 sm:inline-flex sm:shrink-0 sm:items-center sm:gap-1">
                        Saiba mais <ArrowRight class="h-4 w-4 fill-current" />
                    </div>
                </a>
            ))}
        </section>
    )}

    {featuredProjects?.length > 0 && (
        <section class="mb-16 sm:mb-24" aria-labelledby="palestras">
            <h2 id="palestras" class="mb-12 font-serif text-xl italic sm:mb-16 sm:text-2xl">Palestras</h2>
            {featuredProjects.map((project) => (
                <ProjectPreview project={project} class="mb-10 sm:mb-12" headingLevel="h3" />
            ))}
            <div class="mt-12 sm:mt-16">
                <Button href="/palestras">Ver todas as palestras</Button>
            </div>
        </section>
    )}

    {featuredCases.length > 0 && (
        <section class="mb-16 sm:mb-24" aria-labelledby="projetos">
            <h2 id="projetos" class="mb-12 font-serif text-xl italic sm:mb-16 sm:text-2xl">Projetos</h2>
            {featuredCases.map((item) => (
                <CasePreview item={item} class="mb-10 sm:mb-12" headingLevel="h3" />
            ))}
            <div class="mt-12 sm:mt-16">
                <Button href="/projetos">Ver todos os projetos</Button>
            </div>
        </section>
    )}

    {columns.length > 0 && (
        <section class="mb-16 sm:mb-24" aria-labelledby="colunas">
            <h2 id="colunas" class="mb-6 font-serif text-xl italic sm:mb-8 sm:text-2xl">Colunas</h2>
            <ul class="flex flex-wrap gap-x-8 gap-y-3">
                {columns.map((column) => (
                    <li>
                        <a
                            class="font-serif text-xl underline decoration-dashed decoration-1 underline-offset-4 hover:decoration-solid sm:text-2xl"
                            href={column.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {column.text}
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    )}

    {featuredPosts?.length > 0 && (
        <section class="mb-16 sm:mb-24" aria-labelledby="ideias">
            <h2 id="ideias" class="mb-12 font-serif text-xl italic sm:mb-16 sm:text-2xl">Ideias</h2>
            {featuredPosts.map((post) => (
                <PostPreview post={post} class="mb-10 sm:mb-12" headingLevel="h3" />
            ))}
            <div class="mt-12 sm:mt-16">
                <Button href="/ideias">Ver todos os artigos</Button>
            </div>
        </section>
    )}

    <Subscribe class="mb-16 sm:mb-24" />
</BaseLayout>
